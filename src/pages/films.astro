---
import Base from '../layouts/Base.astro';

// Self-hosted, web-optimized 1080p clips in /public/films/.
// Vertical sources are normalized to 16:9 via blurred-fill so the gallery is uniform.
const films = [
  { src: 'jellyfish-01', title: 'Jellyfish',    note: 'aquarium · with detection overlays' },
  { src: 'jellyfish-02', title: 'Jellyfish · II', note: 'aquarium' },
  { src: 'beach',        title: 'Shoreline',    note: 'unreleased' },
  { src: 'greece',       title: 'Greece',       note: 'earth zoom out' },
];
---
<Base title="Films" description="Unreleased clips by Viren Govin — jellyfish, shorelines, and other footage that never made it to the feed.">
  <div class="page container">
    <h1 class="page-title">Films</h1>
    <p class="lede">
      Clips that never made it to the feed — jellyfish, shorelines, and other
      footage I shot and sat on. Tap any to play with sound.
    </p>

    <div class="grid">
      {films.map((f) => (
        <figure class="card" data-film>
          <video
            class="vid"
            src={`/films/${f.src}.mp4`}
            poster={`/films/${f.src}.jpg`}
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={f.title}
          ></video>
          <button class="overlay" type="button" aria-label={`Play ${f.title} with sound`}>
            <span class="play mono">▶ play</span>
          </button>
          <figcaption>
            <span class="t">{f.title}</span>
            <span class="n mono">{f.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr));
    gap: 18px;
  }
  .card { margin: 0; position: relative; }
  .vid,
  .overlay {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    display: block;
  }
  .vid {
    border: 1px solid var(--line);
    background: var(--ground-2);
    object-fit: cover;
  }
  .overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: linear-gradient(to top, rgba(10,14,20,0.5), transparent 45%);
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    transition: background 0.25s;
  }
  .card:hover .overlay { background: linear-gradient(to top, rgba(10,14,20,0.35), rgba(87,226,229,0.06)); }
  .play {
    color: var(--accent);
    font-size: 12px;
    background: rgba(10,14,20,0.6);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 100px;
  }
  .card.playing .overlay { background: none; }
  .card.playing .play { opacity: 0; }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }
  .t { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .n { color: var(--muted); }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-film]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  cards.forEach((card) => {
    const vid = card.querySelector('video') as HTMLVideoElement;
    const btn = card.querySelector('.overlay') as HTMLButtonElement;

    // Click → unmute + fullscreen + play.
    btn.addEventListener('click', () => {
      vid.muted = false;
      vid.play();
      card.classList.add('playing');
      if (vid.requestFullscreen) vid.requestFullscreen().catch(() => {});
    });
    // Re-mute and reset chrome when leaving fullscreen.
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        vid.muted = true;
        card.classList.remove('playing');
      }
    });
  });

  // Autoplay (muted, looping) only while in view — saves CPU/bandwidth. Skipped under reduced-motion.
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const vid = e.target as HTMLVideoElement;
          if (e.isIntersecting) vid.play().catch(() => {});
          else vid.pause();
        });
      },
      { threshold: 0.4 }
    );
    cards.forEach((c) => io.observe(c.querySelector('video') as HTMLVideoElement));
  }
</script>
