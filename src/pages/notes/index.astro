---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const isProd = import.meta.env.PROD;
const posts = (await getCollection('notes'))
  .filter((p) => !(isProd && p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Notes" description="A running research notebook by Viren Govin — post-training, chips, and where tokens come from.">
  <div class="page container">
    <h1 class="page-title">Notes</h1>
    <p class="lede">
      A running notebook. Post-training and RL, where training data actually
      comes from, semiconductors, and whatever physics rabbit hole I'm in.
      Half-formed on purpose.
    </p>

    {posts.length === 0 ? (
      <p class="dim">No notes published yet — first one's coming.</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/notes/${p.id}/`}>
              <span class="when mono">{fmt(p.data.date)}</span>
              <span class="t">{p.data.title}{p.data.draft ? <span class="draft mono"> draft</span> : null}</span>
              {p.data.summary ? <span class="sum dim">{p.data.summary}</span> : null}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { border-bottom: 1px solid var(--line); }
  .list a {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 8px 24px;
    padding: 26px 8px;
    align-items: baseline;
    transition: padding-left 0.25s, background 0.25s;
  }
  .list a:hover { padding-left: 18px; background: linear-gradient(90deg, rgba(87,226,229,0.05), transparent 60%); }
  .when { color: var(--muted); padding-top: 6px; }
  .t { font-size: clamp(22px, 3.2vw, 32px); font-weight: 700; letter-spacing: -0.02em; }
  .draft { color: var(--accent-2); font-size: 10px; vertical-align: middle; }
  .sum { grid-column: 2; font-size: 14px; max-width: 620px; }
  @media (max-width: 620px) {
    .list a { grid-template-columns: 1fr; }
    .sum { grid-column: 1; }
  }
</style>
