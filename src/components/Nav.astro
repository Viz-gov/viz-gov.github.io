---
const path = Astro.url.pathname;
const links = [
  { href: '/work',  label: 'work' },
  { href: '/notes', label: 'notes' },
  { href: '/films', label: 'films' },
  { href: '/about', label: 'about' },
];
const isActive = (href) => path === href || path.startsWith(href + '/');
---
<nav>
  <a href="/" class="wordmark">VIREN</a>
  <div class="navlinks">
    {links.map((l) => (
      <a href={l.href} class:list={["navlink", { active: isActive(l.href) }]}>{l.label}</a>
    ))}
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--pad);
    background: linear-gradient(to bottom, rgba(10,14,20,0.82), rgba(10,14,20,0));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .wordmark {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.22em;
  }
  .navlinks { display: flex; gap: clamp(14px, 3vw, 26px); }
  .navlink {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.62;
    transition: opacity 0.2s, color 0.2s;
  }
  .navlink:hover { opacity: 1; }
  .navlink.active { opacity: 1; color: var(--accent); }
</style>
